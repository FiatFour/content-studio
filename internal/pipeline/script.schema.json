{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "characters", "scenes"],
  "properties": {
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "characters": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "look", "voice"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9]{0,15}$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 60},
          "look": {"type": "string", "minLength": 5, "maxLength": 300},
          "voice": {"type": "string", "minLength": 5, "maxLength": 200}
        }
      }
    },
    "scenes": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["setting", "shots"],
        "properties": {
          "setting": {"type": "string", "minLength": 3, "maxLength": 300},
          "shots": {
            "type": "array", "minItems": 1, "maxItems": 8,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["image_prompt", "camera", "lines"],
              "properties": {
                "image_prompt": {"type": "string", "minLength": 10, "maxLength": 400},
                "camera": {"enum": ["static", "zoom_in", "zoom_out", "pan_left", "pan_right", "pan_up", "pan_down"]},
                "lines": {
                  "type": "array", "maxItems": 6,
                  "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["speaker", "text"],
                    "properties": {
                      "speaker": {"type": "string"},
                      "text": {"type": "string", "minLength": 1, "maxLength": 160}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
