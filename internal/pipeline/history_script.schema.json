{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "language", "beats", "claims"],
  "properties": {
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "language": {"const": "th"},
    "beats": {
      "type": "array", "minItems": 3, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["narration", "claim_ids", "no_factual_claim", "visual"],
        "properties": {
          "narration": {"type": "string", "minLength": 1, "maxLength": 300},
          "claim_ids": {
            "type": "array", "maxItems": 5, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^c[1-9][0-9]{0,2}$"}
          },
          "no_factual_claim": {"type": "boolean"},
          "visual": {"type": "string", "minLength": 8, "maxLength": 200}
        }
      }
    },
    "claims": {
      "type": "array", "minItems": 1, "maxItems": 30,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "text", "certainty", "date_text", "sources"],
        "properties": {
          "id": {"type": "string", "pattern": "^c[1-9][0-9]{0,2}$"},
          "text": {"type": "string", "minLength": 1, "maxLength": 300},
          "certainty": {"enum": ["documented", "disputed", "speculation"]},
          "date_text": {"type": "string", "maxLength": 80},
          "sources": {
            "type": "array", "minItems": 1, "maxItems": 5,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["source_id", "quote"],
              "properties": {
                "source_id": {"type": "string", "pattern": "^s[1-9][0-9]{0,3}$"},
                "quote": {"type": "string", "minLength": 4, "maxLength": 500}
              }
            }
          }
        }
      }
    }
  }
}
