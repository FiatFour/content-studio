{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "language", "beats", "claims"],
  "properties": {
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "language": {"const": "th"},
    "beats": {
      "type": "array", "minItems": 2, "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["narration", "claim_ids", "no_factual_claim"],
        "properties": {
          "narration": {"type": "string", "minLength": 1, "maxLength": 300},
          "claim_ids": {
            "type": "array", "maxItems": 5, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^c[1-9][0-9]{0,2}$"}
          },
          "no_factual_claim": {"type": "boolean"}
        }
      }
    },
    "claims": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "text", "source_id", "quote"],
        "properties": {
          "id": {"type": "string", "pattern": "^c[1-9][0-9]{0,2}$"},
          "text": {"type": "string", "minLength": 1, "maxLength": 300},
          "source_id": {"type": "string", "pattern": "^s[1-9][0-9]{0,3}$"},
          "quote": {"type": "string", "minLength": 4, "maxLength": 500}
        }
      }
    }
  }
}
